  "narrative": {
    "northStar": "深炭金色行情终端",
    "overview": "用户已明确选择参考币安的深色、金色强调和紧凑交易终端语言。当前界面以深炭底色、平面分区、数字密度和真实行情图表构成操作型观察台；品牌使用独立的“OpenPike Stocks”名称及金色 OP 字母组合标志。此名称概括已实现的视觉方向，不表示存在独立获批的设计稿。\n\n图表和盘口是主视觉，金色集中用于身份、选中状态、评分及操作入口。状态文字、来源与时间是界面的一部分：历史快照、形成中K线和未完成核查保持可见。研究评分、手工成交登记、独立纸面账户与前向验证沿用同一套紧凑分区语言。",
    "keyCharacteristics": [
      "深炭平面分区与细边界",
      "金色身份、选中状态和评分",
      "真实K线、成交量与五档盘口",
      "绿色上涨、红色下跌，配合符号和买卖档文字",
      "手机先图表，再盘口与条件，再候选和评分"
    ],
    "rules": [
      {
        "name": "语义行情",
        "body": "上涨与买档使用绿色，下跌与卖档使用红色；涨跌幅保留正负号，档位保留买／卖文字，颜色不是唯一信息。",
        "section": "colors"
      },
      {
        "name": "同股同源状态",
        "body": "选股时价格、盘口、评分、条件与图表同步切换；来源、时间、完整度和阻断原因随对应数据展示，不用视觉上的“通过”替代核验状态。",
        "section": "components"
      }
    ],
    "dos": [
      "Do 沿用深炭、金色、紧凑数字和独立蜡烛品牌标记。",
      "Do 保持手机图表优先；窄手机的买卖盘口分别拥有与数据对齐的列头。",
      "Do 保留金色键盘焦点、正负号、买卖档文字、表格数字对齐与辅助标签。",
      "Do 展示真实OHLC及成交量、周期复权方式、形成中状态和对应来源时间。",
      "Do 保留休市、过期、冲突、缺项与连接中断的文字状态及空数据占位。",
      "Do 让手工真实成交、纸面账户、研究与前向验证保持可识别的独立区域。"
    ],
    "donts": [
      "Don't 复制币安名称、标志或替换独立产品身份。",
      "Don't 将评分、排名或金色强调表现为已验证胜率或收益承诺。",
      "Don't 补造价格、K线、成交量、成交记录或缺失的研究数据。",
      "Don't 把休市和历史快照表现为当前有效报价，或隐藏阻断原因。",
      "Don't 将手工成交登记改成证券委托入口。",
      "Don't 添加与当前平面终端无关的装饰插画、渐变大卡片或悬浮阴影。"
    ]
  }
}
